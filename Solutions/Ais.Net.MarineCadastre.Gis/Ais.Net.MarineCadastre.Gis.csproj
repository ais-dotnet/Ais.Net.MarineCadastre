<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\Endjin.Conventions.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageDescription>Reads the GIS products MarineCadastre.gov (NOAA / BOEM) publishes alongside its AIS archives: the monthly AIS Vessel Tracks GeoPackage as an IObservable of vessel tracks, each a sequence of Ais.Net.Models positions with the vessel's static data, and the yearly AIS Vessel Transit Counts GeoTIFF as an IObservable of cells or tiles. No GDAL required. Sponsored by endjin.</PackageDescription>
    <PackageTags>ais;marinecadastre;noaa;geopackage;gpkg;geotiff;sqlite;tracks;transit-counts;marine;gis;rx;endjin</PackageTags>
    <PackageReleaseNotes>
      Initial release: observable and enumerable readers over the AIS Vessel Tracks GeoPackage (bounding-box, time and MMSI filters) and the AIS Vessel Transit Counts GeoTIFF (point lookup, cells and tiles, bounding-box and level filters).
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ais.Net.Models" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.core" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.MarineCadastre\Ais.Net.MarineCadastre.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ais.Net.MarineCadastre.Tests" />
    <InternalsVisibleTo Include="Ais.Net.MarineCadastre.Benchmarks" />
  </ItemGroup>

</Project>
