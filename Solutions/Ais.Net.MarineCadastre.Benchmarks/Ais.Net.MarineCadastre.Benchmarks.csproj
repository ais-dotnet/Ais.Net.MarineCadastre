<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires a Release build with optimizations. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- CS1591: XML doc comments are not required in the benchmark project. -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Decompresses the NOAA daily CSV (.csv.zst) that the CSV benchmarks download on first use. -->
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.MarineCadastre\Ais.Net.MarineCadastre.csproj" />
    <ProjectReference Include="..\Ais.Net.MarineCadastre.Gis\Ais.Net.MarineCadastre.Gis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GeoPackage and GeoTIFF fixture builders are shared with the Tests project rather than duplicated. -->
    <Compile Include="..\Ais.Net.MarineCadastre.Tests\TestSupport\GeoPackageBuilder.cs" Link="TestSupport\GeoPackageBuilder.cs" />
    <Compile Include="..\Ais.Net.MarineCadastre.Tests\TestSupport\GeoPackageGeometryEncoder.cs" Link="TestSupport\GeoPackageGeometryEncoder.cs" />
    <Compile Include="..\Ais.Net.MarineCadastre.Tests\TestSupport\GeoTiffBuilder.cs" Link="TestSupport\GeoTiffBuilder.cs" />
  </ItemGroup>

</Project>
