<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires a Release build with optimizations. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- CS1591: XML doc comments are not required in the benchmark project. -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.MarineCadastre\Ais.Net.MarineCadastre.csproj" />
    <ProjectReference Include="..\Ais.Net.MarineCadastre.Gis\Ais.Net.MarineCadastre.Gis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GeoPackage and GeoTIFF fixture builders are shared with the Specs project rather than duplicated. -->
    <Compile Include="..\Ais.Net.MarineCadastre.Specs\TestSupport\GeoPackageBuilder.cs" Link="TestSupport\GeoPackageBuilder.cs" />
    <Compile Include="..\Ais.Net.MarineCadastre.Specs\TestSupport\GeoTiffBuilder.cs" Link="TestSupport\GeoTiffBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fallback input when AIS_NET_MARINECADASTRE_CSV is not set: the first rows of a real daily file. -->
    <Content Include="samples\marinecadastre-sample.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
